# 複製成 .env 後填入實際值（.env 不要 commit）

# Ollama 的 OpenAI 相容 API 位址
LLM_BASE_URL=http://localhost:11434/v1
# Ollama 不驗證 key，但 OpenAI SDK 規定要有值，隨便填即可
LLM_API_KEY=ollama
# 要使用的模型名稱，需先執行 ollama pull <模型名稱>
LLM_MODEL=qwen3:8b
# 思考模式強度（qwen3 設 none 可關掉思考、大幅加快回應）；不需要就刪掉這行
LLM_REASONING_EFFORT=none

# 資料庫連線字串（預設是專案目錄下的 SQLite 檔 app.db）
DATABASE_URL=sqlite+aiosqlite:///./app.db

# RAG：embedding 模型（需先 ollama pull bge-m3）
EMBEDDING_MODEL=bge-m3
# Chroma 向量資料庫的存放目錄
CHROMA_PATH=./chroma_data

# 呼叫本服務要帶的 API key（header：X-API-Key），逗號分隔可設多把
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=請換成你自己產生的隨機字串
# 每把 key 每分鐘最多幾個請求
RATE_LIMIT_PER_MINUTE=20
# LLM 請求逾時秒數、失敗重試次數
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# 允許呼叫本服務的前端網域（逗號分隔）
CORS_ORIGINS=http://localhost:5173
